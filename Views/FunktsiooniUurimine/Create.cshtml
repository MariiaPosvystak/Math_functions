@model FunktsiooniUurimine
@{
    ViewData["Title"] = "Uus funktsioon";
}

<h1>Uus funktsioon</h1>

<style>
    .calc { max-width: 420px; margin: 1rem auto; padding: 1rem; border: 1px solid #ccc; border-radius: 12px; background: #f8f9fa; }
    .calc input#expr { width: 100%; font-size: 1.4rem; text-align: right; padding: .4rem .6rem; border: 1px solid #aaa; border-radius: 8px; }
    .calc #result { min-height: 2.2rem; text-align: right; font-size: 1.8rem; font-weight: 600; padding: .2rem .6rem; word-break: break-all; }
    .calc #result.error { color: #c0392b; font-size: 1rem; font-weight: 400; }
    .calc .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
    .calc button { padding: .7rem 0; font-size: 1rem; border: 1px solid #bbb; border-radius: 8px; background: #fff; cursor: pointer; }
    .calc button:hover { background: #e9ecef; }
    .calc button.op { background: #e7f1ff; }
    .calc button.fn { background: #f1f3f5; font-size: .9rem; }
    .calc button.eq { background: #0d6efd; color: #fff; grid-column: span 5; }
    .calc button.danger { background: #ffe3e3; }
    .calc #history { margin-top: 1rem; max-height: 140px; overflow-y: auto; font-size: .9rem; }
    .calc #history div { cursor: pointer; padding: 2px 4px; border-bottom: 1px dashed #ddd; }
    .calc #history div:hover { background: #e9ecef; }
</style>

<div class="calc">
    @Html.AntiForgeryToken()

    <input id="expr" type="text" autocomplete="off" autofocus placeholder="напр. sin(30)+sqrt(16)^2" />
    <div id="result">0</div>

    <div class="grid">
        <button class="fn" data-ins="sin(">sin</button>
        <button class="fn" data-ins="cos(">cos</button>
        <button class="fn" data-ins="tan(">tan</button>
        <button class="fn" data-ins="π">π</button>
        <button class="fn" data-ins="e">e</button>

        <button class="fn" data-ins="asin(">asin</button>
        <button class="fn" data-ins="acos(">acos</button>
        <button class="fn" data-ins="atan(">atan</button>
        <button class="fn" data-ins="ln(">ln</button>
        <button class="fn" data-ins="log(">log</button>

        <button class="fn" data-ins="sqrt(">√</button>
        <button class="fn" data-ins="^2">x²</button>
        <button class="fn" data-ins="^">xʸ</button>
        <button class="fn" data-ins="!">n!</button>
        <button class="fn" data-ins="%">mod</button>

        <button data-ins="7">7</button>
        <button data-ins="8">8</button>
        <button data-ins="9">9</button>
        <button class="op" data-ins="(">(</button>
        <button class="op" data-ins=")">)</button>

        <button data-ins="4">4</button>
        <button data-ins="5">5</button>
        <button data-ins="6">6</button>
        <button class="op" data-ins="×">×</button>
        <button class="op" data-ins="÷">÷</button>

        <button data-ins="1">1</button>
        <button data-ins="2">2</button>
        <button data-ins="3">3</button>
        <button class="op" data-ins="+">+</button>
        <button class="op" data-ins="−">−</button>

        <button data-ins="0">0</button>
        <button data-ins=".">.</button>
        <button id="ans" class="fn">Ans</button>
        <button id="back" class="danger">⌫</button>
        <button id="clear" class="danger">C</button>

        <button id="mode" class="fn" style="grid-column: span 2">Режим: DEG</button>
        <button class="eq" id="eq" style="grid-column: span 3">=</button>
    </div>

    <div id="history"></div>
</div>

@section Scripts {
    <script>
        (function () {
            const expr = document.getElementById('expr');
            const result = document.getElementById('result');
            const history = document.getElementById('history');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            let degrees = true;
            let lastAnswer = '0';

            function insert(text) {
                const s = expr.selectionStart ?? expr.value.length;
                const e = expr.selectionEnd ?? expr.value.length;
                expr.value = expr.value.slice(0, s) + text + expr.value.slice(e);
                const pos = s + text.length;
                expr.setSelectionRange(pos, pos);
                expr.focus();
            }

            async function calculate() {
                try {
                    const resp = await fetch('@Url.Action("Calculate", "Calculator")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ expression: expr.value, degrees })
                    });
                    const data = await resp.json();
                    if (data.ok) {
                        result.className = '';
                        result.textContent = data.result;
                        lastAnswer = data.result;
                        const row = document.createElement('div');
                        row.textContent = expr.value + ' = ' + data.result;
                        row.onclick = () => { expr.value = expr.value; insert(data.result); };
                        history.prepend(row);
                    } else {
                        result.className = 'error';
                        result.textContent = data.error;
                    }
                } catch {
                    result.className = 'error';
                    result.textContent = 'Помилка зʼєднання із сервером';
                }
            }

            document.querySelectorAll('[data-ins]').forEach(b =>
                b.addEventListener('click', () => insert(b.dataset.ins)));

            document.getElementById('eq').addEventListener('click', calculate);
            document.getElementById('ans').addEventListener('click', () => insert(lastAnswer));
            document.getElementById('clear').addEventListener('click', () => {
                expr.value = ''; result.className = ''; result.textContent = '0'; expr.focus();
            });
            document.getElementById('back').addEventListener('click', () => {
                const s = expr.selectionStart;
                if (s > 0) {
                    expr.value = expr.value.slice(0, s - 1) + expr.value.slice(expr.selectionEnd);
                    expr.setSelectionRange(s - 1, s - 1);
                }
                expr.focus();
            });
            document.getElementById('mode').addEventListener('click', e => {
                degrees = !degrees;
                e.target.textContent = 'Режим: ' + (degrees ? 'DEG' : 'RAD');
            });
            expr.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); calculate(); }
            });
        })();
    </script>
}